{
  "name": "About",
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "settings": {
        "layout": "rotating",
        "tone": "accent"
      },
      "blocks": [
        {
          "id": "msg-1",
          "type": "message",
          "settings": {
            "text": "Hot & fresh — order online for delivery or pickup"
          }
        },
        {
          "id": "msg-2",
          "type": "message",
          "settings": {
            "text": "New deals every week. Tap Deals below!",
            "link": "#deals"
          }
        }
      ]
    },
    "order-bar": {
      "type": "order-bar",
      "settings": {
        "layout": "strip",
        "show_status": true,
        "show_phone": true
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "layout": "classic",
        "show_mode_pill": false,
        "show_account": true
      }
    },
    "about": {
      "type": "about",
      "settings": {
        "layout": "image-right",
        "eyebrow": "Our story",
        "title": "About us",
        "heading_level": "h1"
      }
    },
    "reviews": {
      "type": "reviews",
      "settings": {
        "layout": "carousel"
      },
      "blocks": [
        {
          "id": "rev-1",
          "type": "review",
          "settings": {
            "name": "Ayesha K.",
            "rating": 5,
            "text": "Hot, fresh and on time. The zinger is the best in town!",
            "source": "Google"
          }
        },
        {
          "id": "rev-2",
          "type": "review",
          "settings": {
            "name": "Hamza R.",
            "rating": 5,
            "text": "The family deal fed all five of us. Great value.",
            "source": "Facebook"
          }
        },
        {
          "id": "rev-3",
          "type": "review",
          "settings": {
            "name": "Sara M.",
            "rating": 4,
            "text": "Loved the loaded fries. Pickup was ready in 15 minutes.",
            "source": "In store"
          }
        }
      ]
    },
    "cta": {
      "type": "order-cta",
      "settings": {
        "layout": "banner"
      }
    },
    "footer": {
      "type": "footer",
      "settings": {
        "layout": "columns"
      }
    },
    "mobile-bar": {
      "type": "mobile-bar",
      "settings": {
        "layout": "tabs"
      }
    }
  },
  "order": [
    "about",
    "reviews",
    "cta"
  ],
  "header_order": [
    "announcement",
    "order-bar",
    "header"
  ],
  "footer_order": [
    "footer",
    "mobile-bar"
  ]
}
