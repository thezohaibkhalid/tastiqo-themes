{
  "name": "Menu",
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "settings": {
        "layout": "rotating",
        "tone": "accent"
      },
      "blocks": [
        {
          "id": "msg-1",
          "type": "message",
          "settings": {
            "text": "Hot & fresh — order online for delivery or pickup"
          }
        },
        {
          "id": "msg-2",
          "type": "message",
          "settings": {
            "text": "New deals every week. Tap Deals below!",
            "link": "#deals"
          }
        }
      ]
    },
    "order-bar": {
      "type": "order-bar",
      "settings": {
        "layout": "strip",
        "show_status": true,
        "show_phone": true
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "layout": "classic",
        "show_mode_pill": false,
        "show_account": true
      }
    },
    "deals": {
      "type": "deals-section",
      "settings": {
        "eyebrow": "",
        "title": "Deals",
        "subtitle": "",
        "source": "tag",
        "layout": "carousel",
        "columns": 3,
        "limit": 8,
        "anchor": "deals"
      }
    },
    "tabs": {
      "type": "category-tabs",
      "settings": {
        "layout": "pills",
        "sticky": true,
        "link_to": "anchors"
      }
    },
    "menu": {
      "type": "menu-grid",
      "settings": {
        "title": "Menu",
        "layout": "grid",
        "columns": 4,
        "show_search": true,
        "heading_level": "h1"
      }
    },
    "footer": {
      "type": "footer",
      "settings": {
        "layout": "columns"
      }
    },
    "mobile-bar": {
      "type": "mobile-bar",
      "settings": {
        "layout": "tabs"
      }
    }
  },
  "order": [
    "deals",
    "tabs",
    "menu"
  ],
  "header_order": [
    "announcement",
    "order-bar",
    "header"
  ],
  "footer_order": [
    "footer",
    "mobile-bar"
  ]
}
