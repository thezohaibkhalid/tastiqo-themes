<!DOCTYPE html>
<html lang="{{ localization.locale | default: 'en' }}" dir="{% if localization.rtl %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo.title | default: restaurant.name }}</title>
  <meta name="description" content="{{ seo.description | default: restaurant.tagline }}">
  {% if seo.keywords %}<meta name="keywords" content="{{ seo.keywords }}">{% endif %}
  {% if seo.canonical %}<link rel="canonical" href="{{ seo.canonical }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ seo.title | default: restaurant.name }}">
  <meta property="og:description" content="{{ seo.description | default: restaurant.tagline }}">
  <meta property="og:type" content="{{ seo.og_type | default: 'website' }}">
  {% if seo.og_image %}<meta property="og:image" content="{{ seo.og_image }}">{% endif %}
  <meta name="twitter:card" content="{{ seo.twitter_card | default: 'summary_large_image' }}">

  <link rel="icon" href="{{ restaurant.icon }}">

  <!-- Fonts -->
  {%- assign fh_font_heading = theme.font_heading | default: 'Playfair Display' -%}
  {%- assign fh_font_body    = theme.font_body    | default: 'DM Sans' -%}
  {%- assign fh_heading_url  = fh_font_heading | replace: ' ', '+' -%}
  {%- assign fh_body_url     = fh_font_body    | replace: ' ', '+' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- comment -%} Fonts stay render-blocking on purpose: loading them async (preload+onload)
      improved FCP but caused a 0.17-0.19 CLS font swap on mobile in Lighthouse. {%- endcomment -%}
  <link href="https://fonts.googleapis.com/css2?family={{ fh_heading_url }}:wght@400;500;600;700;800&family={{ fh_body_url }}:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Settings may be flat (editor) or grouped (bundled settings_data.json: colors.*, layout.*); empty values keep the theme.css defaults. {%- endcomment -%}
  {%- assign fh_color_primary = theme.color_primary | default: theme.colors.color_primary -%}
  {%- assign fh_color_secondary = theme.color_secondary | default: theme.colors.color_secondary -%}
  {%- assign fh_color_background = theme.color_background | default: theme.colors.color_background -%}
  {%- assign fh_color_dark = theme.color_dark | default: theme.colors.color_dark -%}
  {%- assign fh_max_width = theme.max_width | default: theme.layout.max_width -%}
  {%- assign fh_border_radius = theme.border_radius | default: theme.layout.border_radius -%}
  <style id="fh-theme-tokens">
    :root {
      /* Typography — editable from admin panel */
      --font-heading: '{{ fh_font_heading }}', Georgia, serif;
      --font-body:    '{{ fh_font_body }}', -apple-system, BlinkMacSystemFont, sans-serif;
      --base-font-size: {{ theme.base_font_size | default: 16 }}px;
      --heading-scale:  {{ theme.heading_scale | default: 100 | divided_by: 100.0 }};

      /* Colors — editable from admin panel */
      {% if fh_color_primary.size > 0 %}--color-primary: {{ fh_color_primary }};{% endif %}
      {% if fh_color_secondary.size > 0 %}--color-secondary: {{ fh_color_secondary }};{% endif %}
      {% if fh_color_background.size > 0 %}--color-background: {{ fh_color_background }};{% endif %}
      {% if fh_color_dark.size > 0 %}--color-dark: {{ fh_color_dark }};{% endif %}

      /* Layout — editable from admin panel */
      {% if fh_max_width.size > 0 %}--max-width: {{ fh_max_width }};{% endif %}
      {% if fh_border_radius.size > 0 %}--radius: {{ fh_border_radius }};{% endif %}
    }
  </style>
</head>
<body class="font-body bg-background text-foreground antialiased">

  {% render 'header',
    restaurant: restaurant,
    navigation: navigation,
    branch: branch,
    branch_selector: branch_selector,
    request: request,
    theme: theme,
    ordering: ordering
  %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <script id="storefront-data" type="application/json">
  {
    "branch_id": {{ branch.id | json }},
    "branch_name": {{ branch.name | json }},
    "branch_count": {{ branch_selector.branches.size | default: 1 }},
    "show_branch_popup": {{ branch_selector.show_popup | json }},
    "branches_by_city": [
      {%- for g in branch_selector.cities_grouped -%}
        { "city": {{ g.city | json }}, "branches": [
          {%- for b in g.branches -%}
            { "id": {{ b.id | json }}, "name": {{ b.name | json }}, "address": {{ b.address | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ] }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "currency_symbol": {{ localization.currency_symbol | default: "Rs." | json }}
  }
  </script>

  {% render 'footer',
    restaurant: restaurant,
    navigation: navigation,
    ordering: ordering,
    payments: payments
  %}

  {% render 'branch-selector',
    branch: branch,
    branch_selector: branch_selector,
    request: request
  %}

  {% render 'mobile-bottom-nav',
    request: request,
    ordering: ordering
  %}

  {% render 'floating-whatsapp',
    ordering: ordering
  %}

  {% render 'customer-auth' %}
  {% render 'address-modal' %}
  {%- comment -%} Leaflet (address map) is loaded on demand by theme.js when a map opens. {%- endcomment -%}

  {{ 'theme.js' | asset_url | script_tag }}

  <!-- Storefront-lock overlay: only shown when the restaurant is fully offline.
       Never reveals subscription/billing state to diners. -->
  <style id="tq-sub-style">
    #tq-sub-lock{position:fixed;inset:0;background:rgba(15,15,20,.92);z-index:99999;display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,sans-serif;padding:24px}
    #tq-sub-lock .tq-sub-card{background:#fff;border-radius:16px;padding:32px 28px;max-width:420px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);border-top:5px solid #E11D48}
    #tq-sub-lock h2{margin:0 0 12px;font-size:22px;font-weight:700;color:#1a1a1a}
    #tq-sub-lock p{margin:0;color:#555;font-size:15px;line-height:1.55}
  </style>
  <script>
    (function(){
      function showLock(){
        var el=document.createElement('div');el.id='tq-sub-lock';el.setAttribute('role','alertdialog');el.setAttribute('aria-modal','true');
        el.innerHTML='<div class="tq-sub-card"><h2>Temporarily unavailable</h2><p>We’re not accepting orders at the moment. Please check back soon.</p></div>';
        document.body.appendChild(el);
      }
      document.addEventListener('DOMContentLoaded',function(){
        fetch('/api/public/subscription-info',{credentials:'same-origin'})
          .then(function(r){return r.ok?r.json():null})
          .then(function(info){if(info&&info.is_locked)showLock()})
          .catch(function(){});
      });
    })();
  </script>
</body>
</html>
