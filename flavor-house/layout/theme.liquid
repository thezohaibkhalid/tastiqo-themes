<!DOCTYPE html>
<html lang="{{ localization.locale | default: 'en' }}" dir="{% if localization.rtl %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo.title | default: restaurant.name }}</title>
  <meta name="description" content="{{ seo.description | default: restaurant.tagline }}">
  {% if seo.keywords %}<meta name="keywords" content="{{ seo.keywords }}">{% endif %}
  {% if seo.canonical %}<link rel="canonical" href="{{ seo.canonical }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ seo.title | default: restaurant.name }}">
  <meta property="og:description" content="{{ seo.description | default: restaurant.tagline }}">
  <meta property="og:type" content="{{ seo.og_type | default: 'website' }}">
  {% if seo.og_image %}<meta property="og:image" content="{{ seo.og_image }}">{% endif %}
  <meta name="twitter:card" content="{{ seo.twitter_card | default: 'summary_large_image' }}">

  <link rel="icon" href="{{ restaurant.icon }}">

  <!-- Fonts -->
  {%- assign fh_font_heading = theme.font_heading | default: 'Playfair Display' -%}
  {%- assign fh_font_body    = theme.font_body    | default: 'DM Sans' -%}
  {%- assign fh_heading_url  = fh_font_heading | replace: ' ', '+' -%}
  {%- assign fh_body_url     = fh_font_body    | replace: ' ', '+' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ fh_heading_url }}:wght@400;500;600;700;800&family={{ fh_body_url }}:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style id="fh-theme-tokens">
    :root {
      /* Typography — editable from admin panel */
      --font-heading: '{{ fh_font_heading }}', Georgia, serif;
      --font-body:    '{{ fh_font_body }}', -apple-system, BlinkMacSystemFont, sans-serif;
      --base-font-size: {{ theme.base_font_size | default: 16 }}px;
      --heading-scale:  {{ theme.heading_scale | default: 100 | divided_by: 100.0 }};

      /* Colors — editable from admin panel */
      {% if theme.color_primary %}--color-primary: {{ theme.color_primary }};{% endif %}
      {% if theme.color_secondary %}--color-secondary: {{ theme.color_secondary }};{% endif %}
      {% if theme.color_background %}--color-background: {{ theme.color_background }};{% endif %}
      {% if theme.color_dark %}--color-dark: {{ theme.color_dark }};{% endif %}

      /* Layout — editable from admin panel */
      {% if theme.max_width %}--max-width: {{ theme.max_width }};{% endif %}
      {% if theme.border_radius %}--radius: {{ theme.border_radius }};{% endif %}
    }
  </style>
</head>
<body class="font-body bg-background text-foreground antialiased">

  {% render 'header',
    restaurant: restaurant,
    navigation: navigation,
    branch: branch,
    branch_selector: branch_selector,
    request: request,
    theme: theme,
    ordering: ordering
  %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  <script id="storefront-data" type="application/json">
  {
    "branch_id": {{ branch.id | json }},
    "branch_name": {{ branch.name | json }},
    "branch_count": {{ branch_selector.branches.size | default: 1 }},
    "show_branch_popup": {{ branch_selector.show_popup | json }},
    "currency_symbol": {{ localization.currency_symbol | default: "Rs." | json }}
  }
  </script>

  {% render 'footer',
    restaurant: restaurant,
    navigation: navigation,
    ordering: ordering,
    payments: payments
  %}

  {% render 'branch-selector',
    branch: branch,
    branch_selector: branch_selector,
    request: request
  %}

  {% render 'mobile-bottom-nav',
    request: request,
    ordering: ordering
  %}

  {% render 'floating-whatsapp',
    ordering: ordering
  %}

  {% render 'customer-auth' %}
  {% render 'address-modal' %}
  {% render 'branch-selector' %}

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>

  {{ 'theme.js' | asset_url | script_tag }}

  <!-- Subscription-status popup / lockout overlay (self-contained) -->
  <style id="tq-sub-style">
    #tq-sub-popup{position:fixed;right:20px;bottom:20px;max-width:340px;background:#fff;color:#1C1410;border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.18);font-family:system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.45;z-index:99998;border-left:4px solid var(--tq-accent,#E11D48);padding:16px 36px 16px 16px;animation:tqSubIn .25s ease-out}
    #tq-sub-popup h4{margin:0 0 6px;font-size:15px;font-weight:700;color:var(--tq-accent,#E11D48)}
    #tq-sub-popup p{margin:0;color:#444}
    #tq-sub-popup .tq-sub-close{position:absolute;top:6px;right:8px;background:none;border:0;font-size:20px;line-height:1;cursor:pointer;color:#888;padding:4px}
    #tq-sub-popup .tq-sub-close:hover{color:#222}
    #tq-sub-lock{position:fixed;inset:0;background:rgba(15,15,20,.92);z-index:99999;display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,sans-serif;padding:24px}
    #tq-sub-lock .tq-sub-card{background:#fff;border-radius:16px;padding:32px 28px;max-width:420px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4);border-top:5px solid var(--tq-accent,#E11D48)}
    #tq-sub-lock h2{margin:0 0 12px;font-size:22px;font-weight:700;color:#1a1a1a}
    #tq-sub-lock p{margin:0;color:#555;font-size:15px;line-height:1.55}
    @keyframes tqSubIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  </style>
  <script>
    (function(){
      var ACCENT='#E11D48';
      document.documentElement.style.setProperty('--tq-accent',ACCENT);
      function fmtDate(s){try{var d=new Date(s);return d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'})}catch(e){return s||''}}
      function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
      function fmtDur(s){if(s<=0)return'0s';var d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60),x=s%60;if(d>0)return d+'d '+h+'h';if(h>0)return h+'h '+m+'m';if(m>0)return m+'m '+x+'s';return x+'s'}
      function showGrace(info){
        if(sessionStorage.getItem('tq_storefront_grace_dismissed')==='1')return;
        var secsLeft=Math.max(0,Math.floor((new Date(info.lockout_at).getTime()-Date.now())/1000));
        var el=document.createElement('div');el.id='tq-sub-popup';el.setAttribute('role','alert');
        el.innerHTML='<button type="button" class="tq-sub-close" aria-label="Dismiss">&times;</button>'+
          '<h4>Admin: please clear your bills</h4>'+
          '<p>This site will pause in <strong>'+fmtDur(secsLeft)+'</strong> ('+esc(fmtDate(info.lockout_at))+'). Pay the subscription to keep it live.</p>';
        document.body.appendChild(el);
        el.querySelector('.tq-sub-close').addEventListener('click',function(){sessionStorage.setItem('tq_storefront_grace_dismissed','1');el.remove()});
      }
      function showLock(){
        var el=document.createElement('div');el.id='tq-sub-lock';el.setAttribute('role','alertdialog');el.setAttribute('aria-modal','true');
        el.innerHTML='<div class="tq-sub-card"><h2>Restaurant temporarily unavailable</h2><p>This restaurant’s subscription has expired. Please check back soon.</p></div>';
        document.body.appendChild(el);
      }
      document.addEventListener('DOMContentLoaded',function(){
        fetch('/api/public/subscription-info',{credentials:'same-origin'})
          .then(function(r){return r.ok?r.json():null})
          .then(function(info){if(!info)return;if(info.status==='grace')showGrace(info);else if(info.status==='locked')showLock()})
          .catch(function(){});
      });
    })();
  </script>
</body>
</html>
