{% comment %} Cart Items — JS-rendered from localStorage {% endcomment %}

<section class="cart-page" data-fh-cart-page>
  <div class="container">
    <h1 style="font-size:1.75rem;margin-bottom:1.5rem;">Your Cart</h1>

    <div class="cart-layout" id="fh-cart-filled" style="display:none;">
      <div>
        <div id="cart-items-list" class="cart-items-list">
          <!-- JS renders cart items here -->
        </div>
      </div>

      <!-- Summary rendered by cart-summary section, injected via content_for_cart_summary -->
      {{ content_for_cart_summary }}
    </div>

    <div class="cart-empty" id="fh-cart-empty" style="display:none;">
      <div style="font-size:3rem;margin-bottom:1rem;">🛒</div>
      <h2>Your cart is empty</h2>
      <p>Looks like you haven't added anything yet.</p>
      <a href="/menu" class="btn btn-primary">Browse Menu</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart Items",
  "settings": []
}
{% endschema %}
