<div class="section orders-page" data-section-id="{{ section.id | escape }}" data-section-type="{{ section.type | escape }}" data-orders-page>
  <div class="container">
    <h1 class="page-title" tabindex="-1">{{ section.settings.heading | default: 'My orders' | escape }}</h1>
    <noscript><p class="notice">Your order history needs JavaScript. Please turn it on to continue.</p></noscript>
    {% render 'account-nav', current: 'orders', routes: routes %}
    <div data-orders-root><p class="muted" role="status">Loading your orders…</p></div>
  </div>
</div>

{% schema %}
{
  "name": "Order history",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My orders" }
  ]
}
{% endschema %}
