{% capture ab_img %}{% render 'safe-url', url: section.settings.image %}{% endcapture %}{% assign ab_img = ab_img | strip %}
{% if ab_img == '' and restaurant.cover_image and restaurant.cover_image != '' %}{% assign ab_img = restaurant.cover_image %}{% endif %}
{% assign ab_body = section.settings.body | default: restaurant.description | default: '' %}
<div class="section about-page" data-section-id="{{ section.id | escape }}" data-section-type="{{ section.type | escape }}">
  <div class="container">
    <div class="about{% if ab_img != '' %} about--with-image{% endif %}">
      <div class="about__text">
        <p class="section-kicker">{{ restaurant.name | escape }}</p>
        <h1 class="page-title">{{ section.settings.heading | default: 'About us' | escape }}</h1>
        {% if restaurant.tagline and restaurant.tagline != '' %}<p class="lead">{{ restaurant.tagline | escape }}</p>{% endif %}
        {% if ab_body != '' %}<div class="prose"><p>{{ ab_body | strip_html | escape | newline_to_br }}</p></div>{% endif %}
        <p class="about__cta"><a class="btn btn--accent" href="{{ routes.menu | default: '/menu' }}">{{ section.settings.cta_label | default: 'See the menu' | escape }}</a> <a class="btn btn--ghost" href="{{ routes.locations | default: '/locations' }}">Find a branch</a></p>
      </div>
      {% if ab_img != '' %}<div class="about__media"><img src="{{ ab_img | escape }}" alt="{{ section.settings.image_alt | escape }}" width="800" height="600" loading="lazy" decoding="async"></div>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About us" },
    { "type": "textarea", "id": "body", "label": "Story", "info": "Leave empty to use the description from your restaurant profile.", "default": "" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the menu" }
  ]
}
{% endschema %}
