<section class="section rich-text" data-section-id="{{ section.id | escape }}" data-section-type="{{ section.type | escape }}"{% if section.settings.heading != '' %} aria-labelledby="{{ section.id | escape }}-title"{% else %} aria-label="Information"{% endif %}>
  <div class="container container--narrow-wide">
    {% if section.settings.heading != '' %}<h2 class="section-title" id="{{ section.id | escape }}-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != '' %}<div class="prose"><p>{{ section.settings.text | strip_html | escape | newline_to_br }}</p></div>{% endif %}
    {% capture rt_link %}{% render 'safe-url', url: section.settings.link %}{% endcapture %}{% assign rt_link = rt_link | strip %}
    {% if rt_link != '' and section.settings.button_label != '' %}<p><a class="btn btn--primary" href="{{ rt_link | escape }}">{{ section.settings.button_label | escape }}</a></p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made fresh, every order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-stretched dough, house sauces and generous toppings." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "" },
    { "type": "url", "id": "link", "label": "Button link", "default": "" }
  ],
  "presets": [{ "name": "Text", "category": "Content" }]
}
{% endschema %}
