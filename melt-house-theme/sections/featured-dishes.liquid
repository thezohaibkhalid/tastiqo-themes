{% capture fd_limit %}{% render 'css-number', value: section.settings.limit, min: 1, max: 24, fallback: 6 %}{% endcapture %}{% assign fd_limit = fd_limit | strip | plus: 0 | round %}
{% assign fd_source = section.settings.source | default: 'popular' %}
{% assign fd_items = nil %}
{% assign fd_cat = nil %}
{% case fd_source %}
  {% when 'popular' %}{% assign fd_items = featured.popular %}
  {% when 'new' %}{% assign fd_items = featured.new %}
  {% when 'deals' %}{% assign fd_items = featured.deals %}
  {% when 'spicy' %}{% assign fd_items = featured.spicy %}
  {% when 'veg' %}{% assign fd_items = featured.veg %}
  {% when 'all' %}{% assign fd_items = featured.all %}
  {% when 'category' %}
    {% assign fd_cat_id = section.settings.category | append: '' %}
    {% for c in menu_categories %}{% assign fd_cid = c.id | append: '' %}{% if fd_cid == fd_cat_id %}{% assign fd_items = c.items %}{% assign fd_cat = c %}{% endif %}{% endfor %}
{% endcase %}
{% assign fd_count = 0 %}
{% if fd_source == 'manual' %}
  {% for block in section.blocks %}{% assign fd_pid = block.settings.product | append: '' %}{% for it in featured.all %}{% assign fd_iid = it.id | append: '' %}{% if fd_iid == fd_pid %}{% assign fd_count = fd_count | plus: 1 %}{% endif %}{% endfor %}{% endfor %}
{% else %}
  {% assign fd_count = fd_items.size | default: 0 %}
{% endif %}
{% assign fd_heading = section.settings.heading %}
{% if fd_heading == '' and fd_cat %}{% assign fd_heading = fd_cat.title %}{% endif %}
<section class="section featured" data-section-id="{{ section.id | escape }}" data-section-type="{{ section.type | escape }}" aria-labelledby="{{ section.id | escape }}-title">
  <div class="container">
    <div class="section-head">
      <div>
        {% if section.settings.kicker != '' %}<p class="section-kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
        <h2 class="section-title" id="{{ section.id | escape }}-title">{{ fd_heading | default: 'Popular right now' | escape }}</h2>
      </div>
      {% if section.settings.show_view_all %}<a class="link-more" href="{% if fd_cat %}{{ fd_cat.url | escape }}{% else %}{{ routes.menu | default: '/menu' }}{% endif %}">View all</a>{% endif %}
    </div>
    {% if fd_count > 0 %}
    <div class="item-grid">
      {% if fd_source == 'manual' %}
        {% for block in section.blocks limit: fd_limit %}
          {% assign fd_pid = block.settings.product | append: '' %}
          {% for it in featured.all %}{% assign fd_iid = it.id | append: '' %}{% if fd_iid == fd_pid %}<div class="item-grid__cell" data-block-id="{{ block.id | escape }}" data-block-type="{{ block.type | escape }}">{% render 'item-card', item: it, category_title: '', eager: false %}</div>{% endif %}{% endfor %}
        {% endfor %}
      {% else %}
        {% for it in fd_items limit: fd_limit %}<div class="item-grid__cell">{% render 'item-card', item: it, category_title: '', eager: false %}</div>{% endfor %}
      {% endif %}
    </div>
    {% else %}
    <p class="empty-note">{{ section.settings.empty_text | default: 'Nothing to show here yet — browse the full menu.' | escape }} <a href="{{ routes.menu | default: '/menu' }}">See the menu</a></p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured dishes",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Customer favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular right now" },
    { "type": "select", "id": "source", "label": "Dishes to show", "default": "popular", "options": [
      { "value": "popular", "label": "Tagged popular / bestseller" },
      { "value": "new", "label": "Tagged new" },
      { "value": "deals", "label": "Tagged deals" },
      { "value": "spicy", "label": "Tagged spicy" },
      { "value": "veg", "label": "Tagged vegetarian" },
      { "value": "all", "label": "All dishes" },
      { "value": "category", "label": "One category" },
      { "value": "manual", "label": "Dishes I pick (add blocks)" }
    ] },
    { "type": "collection", "id": "category", "label": "Category (when 'One category' is selected)" },
    { "type": "range", "id": "limit", "label": "Maximum dishes", "min": 1, "max": 24, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "text", "id": "empty_text", "label": "Message when nothing matches", "default": "Nothing to show here yet — browse the full menu." }
  ],
  "blocks": [
    { "type": "dish", "name": "Dish", "settings": [ { "type": "product", "id": "product", "label": "Dish" } ] }
  ],
  "max_blocks": 24,
  "presets": [
    { "name": "Popular dishes", "category": "Menu", "settings": { "source": "popular", "heading": "Popular right now" } },
    { "name": "Deals", "category": "Menu", "settings": { "source": "deals", "heading": "Deals", "kicker": "Save more" } }
  ]
}
{% endschema %}
