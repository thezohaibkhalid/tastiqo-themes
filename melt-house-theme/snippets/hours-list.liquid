{% comment %}Opening hours as returned by the platform (display format, Monday first).{% endcomment %}{% if hours.size > 0 %}<dl class="hours">{% for h in hours %}<div class="hours__row"><dt>{{ h.day | escape }}</dt><dd>{% if h.closed %}Closed{% else %}{{ h.open | escape }} – {{ h.close | escape }}{% endif %}</dd></div>{% endfor %}</dl>{% else %}<p class="muted">Opening hours have not been published yet.</p>{% endif %}
