{% comment %}Price for a Liquid menu item (minor units). Shows "was" only when compare-at is higher.{% endcomment %}{% assign pr_from = false %}{% for pr_g in item.modifier_groups %}{% if pr_g.required %}{% for pr_o in pr_g.options %}{% if pr_o.price_delta > 0 %}{% assign pr_from = true %}{% endif %}{% endfor %}{% endif %}{% endfor %}<span class="price{% if item.hasDiscount %} price--sale{% endif %}">{% if pr_from %}<span class="price__from">from</span> {% endif %}<span class="price__now">{% if item.priceMoney %}{{ item.priceMoney | escape }}{% else %}{{ item.price | money }}{% endif %}</span>{% if item.compareAtPrice > item.price %} <s class="price__was"><span class="visually-hidden">was </span>{% if item.compareAtPriceMoney %}{{ item.compareAtPriceMoney | escape }}{% else %}{{ item.compareAtPrice | money }}{% endif %}</s>{% endif %}</span>
