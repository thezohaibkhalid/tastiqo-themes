{% comment %}Public, non-sensitive storefront data for theme.js. Every value goes through json and "<" is escaped so merchant text cannot close the script element.{% endcomment %}
{% capture sd_json %}{"restaurant":{"id":{{ restaurant.id | json | default: 'null' }},"name":{{ restaurant.name | json | default: 'null' }},"phone":{{ restaurant.phone | json | default: 'null' }},"email":{{ restaurant.email | json | default: 'null' }},"is_open":{{ restaurant.is_open | json | default: 'null' }}},"localization":{"currency":{{ localization.currency | json | default: 'null' }},"currency_symbol":{{ localization.currency_symbol | json | default: 'null' }},"minor_units":{{ localization.minor_units | json | default: 'null' }},"timezone":{{ localization.timezone | json | default: 'null' }}},"branch":{"id":{{ branch.id | json | default: 'null' }},"name":{{ branch.name | json | default: 'null' }},"address":{{ branch.address | json | default: 'null' }},"city":{{ branch.city | json | default: 'null' }},"phone":{{ branch.phone | json | default: 'null' }},"selected":{{ branch.selected | json | default: 'null' }}},"branches":{{ branch_selector.branches | json | default: '[]' }},"has_multiple":{{ branch_selector.has_multiple | json | default: 'null' }},"set_branch_url":{{ branch_selector.set_branch_url | json | default: 'null' }},"routes":{{ routes | json | default: '{}' }},"page_type":{{ request.page_type | json | default: 'null' }},"path":{{ request.path | json | default: 'null' }},"params":{{ request.params | json | default: '{}' }},"today":{{ utils.today | json | default: 'null' }},"now":{{ utils.now | json | default: 'null' }},"categories":{{ menu_categories | json | default: '[]' }}}{% endcapture %}
<script type="application/json" id="site-data">{{ sd_json | replace: '<', '<' }}</script>
