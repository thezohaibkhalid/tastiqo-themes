  },
  {
    "name": "Social and maps",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_whatsapp", "label": "WhatsApp link or number" },
      { "type": "url", "id": "social_google_maps", "label": "Google Maps link" }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      { "type": "text", "id": "seo_title", "label": "Home page title" },
      { "type": "textarea", "id": "seo_description", "label": "Meta description" },
      { "type": "image_picker", "id": "seo_og_image", "label": "Social share image" }
    ]
  },
  {
    "name": "Advanced",
    "settings": [
      { "type": "textarea", "id": "custom_css", "label": "Custom CSS" },
      { "type": "textarea", "id": "custom_js", "label": "Custom JavaScript (vetted code only)" }
    ]
